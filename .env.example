# ===== VoteChain: mau cau hinh. Sao chep thanh .env (da nam trong .gitignore) va dien gia tri that. =====
# CANH BAO: file .env.example nay duoc commit len GitHub. KHONG bao gio dien khoa bi mat vao day.

# ---------- A. Cong khai (an toan khi dat o frontend) ----------
SUPABASE_URL=https://vfzuniykinaivchhuiul.supabase.co
# Khoa "publishable" (truoc day goi la anon key) duoc thiet ke de cong khai; quyen that su do RLS quyet dinh.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_EDmldUtxLGO4J5EvAE0DHQ__RVMvuYu

# Sau khi deploy Giai doan 6 (dien dia chi that, khong tu che):
REGISTRY_ADDRESS=
CORE_ADDRESS=
CHAIN_ID=11155111

# ---------- B. BI MAT: chi dat trong "Edge Function secrets" cua Supabase, KHONG vao frontend/GitHub ----------
# SUPABASE_URL, SUPABASE_ANON_KEY va SUPABASE_SERVICE_ROLE_KEY duoc Supabase TU DONG cap cho Edge Function.
# Ban khong can (va khong the) tu dat cac bien bat dau bang SUPABASE_. Khong sao chep service_role vao dau ca.
#
# Dat bang:  supabase secrets set --env-file supabase/.env.functions   (file nay khong commit)
SITE_DOMAIN=                  # ten mien trang web, vi du votechain.example.com (hoac localhost:8080 khi thu)
ALLOWED_ORIGINS=              # origin duoc goi ham, phan tach bang dau phay, vi du https://votechain.example.com,http://localhost:8080
RPC_URL=                      # RPC Sepolia (Alchemy / Infura / publicnode). Co the chua khoa API => la bi mat
DEPLOY_BLOCK=0                # so khoi luc deploy ProjectCore, de chain-sync khong quet tu khoi 0
SYNC_SECRET=                  # chuoi ngau nhien dai >= 32 ky tu cho cron goi chain-sync (tao bang: openssl rand -hex 32)
SYNC_MIN_INTERVAL_SECONDS=15
RATE_LIMIT_SALT=              # muoi bam IP khi gioi han tan suat dang nhap (openssl rand -hex 16); bo trong thi dung SYNC_SECRET

# ---------- C. Chi dung cuc bo khi chay Supabase CLI (khong commit) ----------
# SUPABASE_ACCESS_TOKEN=      # token CLI tao tai Dashboard > Account > Access Tokens
# SUPABASE_DB_PASSWORD=       # mat khau database khi chay `supabase db push`
